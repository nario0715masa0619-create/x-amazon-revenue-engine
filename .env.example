# x_metrics_collector 用の環境変数テンプレート。
# 実際の値は入れず、コピーして .env を作成し（このリポジトリのルート直下に置く）、
# .env の方に値を設定すること。.env はコミットしない（.gitignore で除外済み）。
# セットアップ手順の詳細は scripts/x_metrics_collector/README.md を参照。

# =========================================================
# 【必須】Google Sheets（サービスアカウント認証）
# =========================================================
GOOGLE_SHEETS_SPREADSHEET_ID=19QBFTd6j4_hlV38VhPaVtTLmhlzw5HNQNmyPhmkfmtM

# GOOGLE_SERVICE_ACCOUNT_JSON_PATH と GOOGLE_SERVICE_ACCOUNT_JSON_BASE64 は
# どちらか一方だけ設定すればよい（両方設定した場合は _PATH が優先される）。
#
# 通常はこちら（JSONキーファイルをローカルに置ける場合）:
#   Windows例:    GOOGLE_SERVICE_ACCOUNT_JSON_PATH=C:\Users\you\secrets\service-account-key.json
#   Mac/Linux例:  GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/home/you/secrets/service-account-key.json
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ファイルを置きたくない環境（CI等）向けの代替: JSON内容をbase64エンコードした文字列
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# =========================================================
# 【必須・最低1つ】X API v2
# =========================================================
# --- パターンA: public metricsのみでよい場合（最小構成） ---
# Bearer Tokenだけを設定する。impression/like/reply/bookmarkは取得できるが、
# user_profile_clicks等は取得できない（data_quality: partial、profile_visit_rateは空欄になる）。
X_BEARER_TOKEN=

# --- パターンB: non-public metrics（profile_visit_rate算出）も取得したい場合 ---
# 上記に加えて、投稿アカウント自身のOAuth 2.0 User Context トークンを設定する。
# 取得方法（初回のみ・人間の一度きりの作業）は scripts/x_metrics_collector/README.md 参照。
X_USER_ACCESS_TOKEN=

# =========================================================
# 【任意】シート名（通常は変更不要。posts/metrics_24hのシート名を変えた場合のみ編集）
# =========================================================
POSTS_SHEET_NAME=posts
METRICS_SHEET_NAME=metrics_24h
