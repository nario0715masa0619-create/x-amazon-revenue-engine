# x_metrics_collector 用の環境変数テンプレート。
# 実際の値は入れず、コピーして .env を作成し、.env の方に値を設定すること。
# .env はコミットしない（.gitignore で除外する）。

# --- Google Sheets（サービスアカウント認証） ---
GOOGLE_SHEETS_SPREADSHEET_ID=19QBFTd6j4_hlV38VhPaVtTLmhlzw5HNQNmyPhmkfmtM

# 以下のいずれか一方を設定する
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- X API v2 ---
# public_metrics（impression/like/reply/bookmark）のみでよければBearer Tokenだけで動く
# （その場合 data_quality は partial になる）
X_BEARER_TOKEN=

# user_profile_clicks 等 non-public/organic metrics を取得するには、
# 投稿アカウント自身のOAuth 2.0 User Contextトークンが必要
# （取得方法は scripts/x_metrics_collector/README.md 参照）
X_USER_ACCESS_TOKEN=

# --- シート名（通常は変更不要） ---
POSTS_SHEET_NAME=posts
METRICS_SHEET_NAME=metrics_24h
